# ---------------------------------------------------------------------------
# WhatsApp Multi-Device Controller — variabel environment
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.
# Dibuat oleh Rifky.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# LOKAL (SQLite, tanpa setup — file di samping prisma/schema.prisma):
DATABASE_URL="file:./dev.db"

# RAILWAY / PRODUKSI (PostgreSQL):
# 1. Dashboard Railway -> project -> New -> Database -> Add PostgreSQL
# 2. Railway otomatis menyuntikkan DATABASE_URL ke service bila plugin Postgres
#    ada di project yang sama (Variables -> Add Reference -> DATABASE_URL).
#    Formatnya: postgresql://postgres:password@host:5432/railway
# Contoh manual:
# DATABASE_URL="postgresql://user:password@host:5432/railway"

# --- Server -----------------------------------------------------------------
# Port HTTP (Railway mengisi PORT otomatis).
PORT=3000
HOSTNAME=0.0.0.0

# --- Login panel (SANGAT DISARANKAN) ----------------------------------------
# Bila AUTH_PASSWORD diisi, seluruh panel + websocket + API media terkunci
# dan wajib login lewat halaman /login.
# Bila dikosongkan, panel terbuka untuk siapa pun yang tahu alamatnya.
AUTH_PASSWORD=ganti-dengan-password-kuat

# Username untuk login (opsional, default: admin).
AUTH_USERNAME=admin

# Kunci acak untuk tanda tangan cookie sesi. Opsional — bila kosong, kunci
# diturunkan dari AUTH_PASSWORD. Isi 32+ karakter acak untuk keamanan maksimal.
# AUTH_SECRET=ubah-jadi-string-acak-panjang

# Lama sesi login dalam hari (default 7). "Ingat saya" = 30 hari.
AUTH_SESSION_DAYS=7

# --- Penyimpanan runtime ----------------------------------------------------
# File auth Baileys (sesi) dan media hasil unduhan.
# Di Railway, pasang Volume di /app/data agar sesi tetap ada setelah redeploy.
WA_AUTH_DIR=./data/auth
WA_MEDIA_DIR=./data/media

# Batas ukuran berkas media yang diunduh/disimpan (MB).
WA_MAX_MEDIA_MB=64

# --- Perilaku ---------------------------------------------------------------
# Otomatis restore + reconnect semua sesi tersimpan saat server menyala.
WA_AUTO_RESTORE=true

# Minta riwayat pesan PENUH dari WhatsApp saat perangkat baru ditautkan
# (lebih berat di CPU/RAM untuk akun besar). false = hanya sinkron terbaru.
WA_SYNC_FULL_HISTORY=false

# Batas jumlah pesan hasil history sync yang diimpor (per sesi).
WA_HISTORY_MESSAGE_LIMIT=3000

# Level log: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# --- Branding (opsional) ----------------------------------------------------
NEXT_PUBLIC_APP_NAME=WA Multi-Device Controller
NEXT_PUBLIC_DEVELOPER_NAME=Rifky
# NEXT_PUBLIC_DEVELOPER_URL=https://github.com/usernamekamu
